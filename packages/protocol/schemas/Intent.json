{
  "$ref": "#/definitions/Intent",
  "definitions": {
    "Intent": {
      "type": "object",
      "properties": {
        "intentId": {
          "type": "string",
          "pattern": "^int_[a-z0-9]{12}$"
        },
        "runId": {
          "type": "string"
        },
        "planId": {
          "type": "string"
        },
        "toolRef": {
          "type": "string"
        },
        "args": {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "fact"
                  },
                  "param": {
                    "type": "string"
                  },
                  "factId": {
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "param",
                  "factId"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "user"
                  },
                  "param": {
                    "type": "string"
                  },
                  "userValue": {},
                  "decidedBy": {
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "param",
                  "decidedBy"
                ],
                "additionalProperties": false
              }
            ]
          }
        },
        "idempotencyKey": {
          "type": "string"
        },
        "proposedBy": {
          "type": "string",
          "enum": [
            "model",
            "user",
            "sop"
          ]
        },
        "checkpoint": {
          "type": "string",
          "enum": [
            "show",
            "notify",
            "confirm"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "proposed",
            "approved",
            "rejected",
            "revalidating",
            "stale",
            "executing",
            "settled"
          ]
        },
        "batchId": {
          "type": "string"
        },
        "version": {
          "type": "integer",
          "minimum": 0
        },
        "requiresRatification": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "intentId",
        "runId",
        "toolRef",
        "args",
        "idempotencyKey",
        "proposedBy",
        "checkpoint",
        "status",
        "version"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
