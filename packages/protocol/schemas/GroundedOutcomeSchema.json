{
  "$ref": "#/definitions/GroundedOutcomeSchema",
  "definitions": {
    "GroundedOutcomeSchema": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "settled"
            },
            "receipt": {
              "type": "object",
              "properties": {
                "intentId": {
                  "type": "string"
                },
                "status": {
                  "type": "string",
                  "enum": ["confirmed", "failed", "unknown", "pending"]
                },
                "externalRef": {
                  "type": "string"
                },
                "errorCode": {
                  "type": "string"
                },
                "rawHash": {
                  "type": "string"
                },
                "recordedAt": {
                  "type": "string",
                  "format": "date-time"
                },
                "signature": {
                  "type": "string"
                }
              },
              "required": ["intentId", "status", "rawHash", "recordedAt", "signature"],
              "additionalProperties": false
            }
          },
          "required": ["kind", "receipt"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "stale"
            },
            "intentId": {
              "type": "string"
            },
            "version": {
              "type": "integer",
              "minimum": 0
            },
            "changedFactIds": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": ["kind", "intentId", "version"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "rejected"
            },
            "reason": {
              "type": "string"
            }
          },
          "required": ["kind", "reason"],
          "additionalProperties": false
        }
      ]
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
