{
  "$ref": "#/definitions/GroundedSubmitResultSchema",
  "definitions": {
    "GroundedSubmitResultSchema": {
      "anyOf": [
        {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "settled"
                },
                "receipt": {
                  "type": "object",
                  "properties": {
                    "intentId": {
                      "type": "string"
                    },
                    "status": {
                      "type": "string",
                      "enum": [
                        "confirmed",
                        "failed",
                        "unknown",
                        "pending"
                      ]
                    },
                    "externalRef": {
                      "type": "string"
                    },
                    "errorCode": {
                      "type": "string"
                    },
                    "rawHash": {
                      "type": "string"
                    },
                    "recordedAt": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "signature": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "intentId",
                    "status",
                    "rawHash",
                    "recordedAt",
                    "signature"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "kind",
                "receipt"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "stale"
                },
                "intentId": {
                  "type": "string"
                },
                "version": {
                  "type": "integer",
                  "minimum": 0
                },
                "changedFactIds": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "required": [
                "kind",
                "intentId",
                "version"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "rejected"
                },
                "reason": {
                  "type": "string"
                }
              },
              "required": [
                "kind",
                "reason"
              ],
              "additionalProperties": false
            }
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "awaiting_confirmation"
            },
            "confirmation": {
              "type": "object",
              "properties": {
                "schemaVersion": {
                  "type": "string",
                  "const": "grounded.confirmation.v1"
                },
                "runId": {
                  "type": "string",
                  "minLength": 1
                },
                "intentId": {
                  "type": "string",
                  "minLength": 1
                },
                "intentVersion": {
                  "type": "integer",
                  "minimum": 0
                },
                "toolRef": {
                  "type": "string",
                  "minLength": 1
                },
                "parameterSetDigest": {
                  "type": "string",
                  "minLength": 1
                },
                "cardDigest": {
                  "type": "string",
                  "minLength": 1
                },
                "issuedAt": {
                  "type": "string",
                  "format": "date-time"
                },
                "confirmationToken": {
                  "type": "string",
                  "minLength": 1
                },
                "card": {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "const": "action-confirmation-card"
                    },
                    "toolTitle": {
                      "type": "string"
                    },
                    "args": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "param": {
                            "type": "string"
                          },
                          "label": {
                            "type": "string"
                          },
                          "binding": {},
                          "fact": {},
                          "editable": {
                            "type": "boolean"
                          },
                          "valueType": {
                            "type": "string",
                            "enum": [
                              "string",
                              "number",
                              "boolean",
                              "null",
                              "complex"
                            ]
                          },
                          "requiresRatification": {
                            "type": "boolean"
                          }
                        },
                        "required": [
                          "param",
                          "label",
                          "editable",
                          "valueType",
                          "requiresRatification"
                        ],
                        "additionalProperties": false
                      }
                    },
                    "requiresRatification": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  },
                  "required": [
                    "type",
                    "toolTitle",
                    "args"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "schemaVersion",
                "runId",
                "intentId",
                "intentVersion",
                "toolRef",
                "parameterSetDigest",
                "cardDigest",
                "issuedAt",
                "confirmationToken",
                "card"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "kind",
            "confirmation"
          ],
          "additionalProperties": false
        }
      ]
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
