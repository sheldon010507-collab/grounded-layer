{
  "name": "@grounded/agui-bridge",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "description": "HarnessEvent → AG-UI 事件桥接:生命周期事件映射到标准 RUN_STARTED/RUN_FINISHED/RUN_ERROR,Grounded 专有事件走 CUSTOM 原样透传(Part E.8)",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.typecheck.json"
  },
  "dependencies": {
    "@ag-ui/core": "0.0.57",
    "@grounded/protocol": "workspace:*"
  },
  "devDependencies": {
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
